---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { cn } from "@/lib/utils";

interface Props {
  title?: string;
}

const { title = "10xCards" } = Astro.props;
const { user } = Astro.locals;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    {
      user && (
        <header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/80 backdrop-blur-md">
          <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
            <div class="flex items-center gap-6 sm:gap-8">
              <a
                href="/dashboard"
                class="flex items-center gap-2 text-lg font-bold text-white transition-opacity hover:opacity-90"
              >
                <span class="bg-gradient-to-r from-blue-300 via-purple-300 to-pink-300 bg-clip-text text-transparent">
                  10xCards
                </span>
              </a>
              <nav class="flex items-center gap-1 sm:gap-2">
                <a
                  href="/dashboard"
                  class:list={cn(
                    "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
                    pathname === "/dashboard" || pathname === "/generate"
                      ? "bg-white/15 text-white"
                      : "text-blue-100/70 hover:bg-white/10 hover:text-white",
                  )}
                >
                  Dashboard
                </a>
                <a
                  href="/study"
                  class:list={cn(
                    "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
                    pathname === "/study"
                      ? "bg-white/15 text-white"
                      : "text-blue-100/70 hover:bg-white/10 hover:text-white",
                  )}
                >
                  Study
                </a>
                <a
                  href="/stats"
                  class:list={cn(
                    "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
                    pathname === "/stats"
                      ? "bg-white/15 text-white"
                      : "text-blue-100/70 hover:bg-white/10 hover:text-white",
                  )}
                >
                  Stats
                </a>
              </nav>
            </div>
            <div class="flex items-center gap-3 sm:gap-4">
              {user.email && <span class="hidden text-xs text-blue-100/60 sm:inline-block">{user.email}</span>}
              <form method="POST" action="/api/auth/signout" class="inline">
                <button
                  type="submit"
                  class="cursor-pointer rounded-lg border border-white/20 bg-white/5 px-3 py-1.5 text-xs font-medium text-white/80 transition-colors hover:bg-white/15 hover:text-white"
                >
                  Sign Out
                </button>
              </form>
            </div>
          </div>
        </header>
      )
    }
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
